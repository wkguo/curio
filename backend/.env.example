# Curio backend configuration. Copy to .env and edit.

# auto  = use the LLM when an API key is configured, otherwise deterministic rules
# rules = never call an LLM (deterministic demo mode — recommended for live demos)
# llm   = always try the LLM first (falls back to rules on any failure)
CURIO_HARNESS_MODE=rules

# Any OpenAI-compatible Chat Completions endpoint (OpenAI, Qwen/DashScope, DeepSeek,
# Gemini's OpenAI endpoint, vLLM, Ollama, an Anthropic-compatible gateway, ...)
CURIO_LLM_BASE_URL=https://api.openai.com/v1
CURIO_LLM_API_KEY=
CURIO_LLM_MODEL=gpt-4o-mini
CURIO_LLM_TIMEOUT_S=25

CURIO_DATABASE_URL=sqlite:///./curio.db
CURIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
